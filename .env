DB_HOST=sqlXXX.epizy.com
DB_USER=if0_XXXXXXXX
DB_PASS=YOUR_DATABASE_PASSWORD
DB_NAME=if0_XXXXXXXX_riit
DB_PORT=3306

# Application Mode
APP_ENV=production
